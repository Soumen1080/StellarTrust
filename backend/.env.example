# StellarTrust backend — environment template.
# ⚠️  NEVER put real secret keys here or in any committed file (Rules.md #2).
# Secrets are resolved at runtime from a secret manager / KMS boundary.
# Values below are non-secret config or *references* to secrets.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Exact browser origin allowed by the API CORS boundary.
FRONTEND_ORIGIN=http://localhost:3000
# Additional comma-separated deployed frontend origins (env-driven).
# Production frontend (Vercel):
FRONTEND_ORIGINS=https://stellar-trust-frontend.vercel.app

# ── Database (Supabase / Postgres) ──────────────────────────────────────────
# In real environments this comes from the secret manager, not this file.
# Supabase → Settings → Database → Connection string (contains the DB password).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellartrust

# ── Redis (jobs / idempotency store in later phases) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase project (Auth / Storage / API) ─────────────────────────────────
# Optional in Phase 0. Used by the Supabase admin client + JWKS auth verifier.
# SUPABASE_SECRET_KEY is a SERVER-ONLY secret — never expose it to the client
# and never commit a real value (put it in a local .env / secret manager).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── Stellar network ─────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Signing boundary (KMS/HSM) ──────────────────────────────────────────────
# NO secret keys in env. Provide the *provider* and a *key reference/ARN* only.
# provider = local-stub | aws-kms | gcp-kms
SIGNER_PROVIDER=local-stub
# e.g. arn:aws:kms:us-east-1:123456789012:key/abcd-...  (a reference, not a key)
SIGNER_KEY_REF=local-stub-key-ref

# ── Development / demo shortcuts (see devlopement.md §6/§7) ──────────────────
# DEMO_MODE unlocks a STABLE testnet-only signer loaded from DEMO_SIGNER_SECRET
# so deployed demos work without KMS. Forbidden on the public network. Real
# production signing must use SIGNER_PROVIDER=aws-kms|gcp-kms instead.
DEMO_MODE=false
# Stellar TESTNET secret seed (S...) for the demo signer. Put the real value in
# the host secret manager, NEVER commit it. Fund this account on testnet.
# DEMO_SIGNER_SECRET=S...
# Auto-verify KYC after a short delay for smooth development. Ignored in
# production regardless of value.
KYC_AUTO_APPROVE=false
KYC_AUTO_APPROVE_DELAY_MS=10000

# ── AI Risk Service (advisory) ──────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── OpenAI advisory engine (optional KYC profile-review backend) ─────────────
# When KYC_RISK_ENGINE=openai and OPENAI_API_KEY is set, KYC profile risk is
# scored by OpenAI (advisory only — never moves funds/ledger; a failure
# degrades to human review). The key is a secret: provide it via the
# gitignored local .env or a secret manager, never in committed source.
KYC_RISK_ENGINE=service
# OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=15000

# ── Auth / SEP-10 ───────────────────────────────────────────────────────────
# Dev bearer is used only when no real verifier is configured; tests also use it
# for the compliance-review fixture. Real users authenticate by signing SEP-10.
AUTH_DEV_BEARER=dev-local-token
# Optional development-only wallet account. It still must sign the SEP-10
# challenge; when authenticated it receives user + compliance access.
# AUTH_DEMO_WALLET=G...
AUTH_DEMO_NAME=sam
SEP10_HOME_DOMAIN=localhost
SEP10_WEB_AUTH_DOMAIN=localhost:8080
SEP10_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=3600

# ── KYC/KYB provider + advisory decision policy ──────────────────────────────
KYC_PROVIDER=sandbox
KYC_AI_TIMEOUT_MS=3000
KYC_APPROVE_MAX_RISK=0.35
KYC_REJECT_MIN_RISK=0.7
KYC_MIN_CONFIDENCE=0.7

# Ledger ↔ chain reconciliation cadence. Any mismatch blocks the order.
RECONCILIATION_INTERVAL_MS=60000
# deterministic is local/test only. soroban-rpc submits real Soroban txs via the
# signing boundary (use DEMO_MODE + DEMO_SIGNER_SECRET on testnet).
#
# Switching to soroban-rpc takes on-chain setup, not just this flag — the
# accounts, the token contract, and the uploaded WASM all have to exist first.
# docs/testnet-onchain-setup.md is the runbook; in short:
#   contracts/scripts/setup-testnet.ps1    # accounts + test asset + its SAC
#   contracts/scripts/deploy-testnet.ps1   # upload WASM -> ESCROW_WASM_HASH
#   contracts/scripts/fund-wallet.ps1      # trustline + balance per wallet
#   npm run chain:preflight                # verify all of it against the network
ESCROW_GATEWAY=deterministic
# Hex WASM hash of the escrow contract, already uploaded on-chain. The backend
# deploys one custody instance per order from this hash, so it needs the hash
# rather than a contract id. Get it from contracts/scripts/deploy-testnet.ps1.
# Required when ESCROW_GATEWAY=soroban-rpc (boot fails without it).
# ESCROW_WASM_HASH=
#
# Soroban token contracts backing each ledger currency. Escrow moves real token
# balances, so a currency with no binding here cannot go on-chain. `decimals`
# is the token contract's own decimals (7 for a classic Stellar asset contract)
# and defaults to 7; the ledger's minor units are converted to it exactly.
# At least one binding is required when ESCROW_GATEWAY=soroban-rpc.
# STELLAR_TOKEN_CONTRACTS={"USDC":{"contractId":"C...","decimals":7}}
#
# On-chain arbiter for new escrows — the account allowed to release/refund and
# to raise a dispute so an unconfirmed escrow becomes settleable. Defaults to
# the server signer's own address.
#
# Point this at a separate account (a multi-sig, or a key on separate hardware)
# to take settlement authority out of a single server key. Doing so changes how
# release and refund work, by design:
#   - they become prepare -> sign -> submit instead of a single server call
#     (POST /orders/:id/release/prepare, then .../release/submit);
#   - `GET /api/payments/capabilities` reports them as wallet-signed, so a
#     client does not have to know which mode is active;
#   - a resolved dispute no longer auto-executes. The resolution stands as the
#     authorization and a human carries it to the key holders. That is the
#     point: no single compromised process can move custodied funds.
# For a multi-sig account, collect signatures on the returned XDR however your
# operators do it and submit the fully-signed envelope; Stellar enforces the
# account's thresholds.
# ESCROW_ARBITER_ADDRESS=
#
# How long a prepared (unsigned) escrow transaction stays submittable. The
# buyer signs it in the browser within one interaction, so keep this short.
ESCROW_PREPARED_TX_TTL_SECONDS=300

# ── Phase 5: RWA Tokenization ───────────────────────────────────────────────
# deterministic is local/test only. soroban-rpc deploys per-tokenization token
# contracts and submits transfers/authorize/freeze via the signing boundary.
RWA_GATEWAY=deterministic
# Hex WASM hash of the RWA token contract, already uploaded on-chain. Required
# when RWA_GATEWAY=soroban-rpc (boot fails without it).
# RWA_WASM_HASH=
#
# Who holds the tokenized supply on-chain.
#   platform — the server signer is the on-chain issuer and holds every unit.
#     One call per operation, and entirely custodial: the issuer recorded in
#     our tables owns nothing on-chain.
#   issuer   — the issuer's own SEP-10 wallet is the on-chain issuer and holds
#     the supply. They sign their own operations via
#     POST /rwa/tokenizations/:id/{deploy,transfer,freeze,...}/prepare|submit
#     (see GET /api/rwa/capabilities).
#
# Choosing `issuer` has consequences worth understanding before you flip it:
#   - a purchase is recorded as a PENDING holding and delivers no units until
#     the issuer signs the transfer. Pending holdings earn no payout and are
#     reported as outstanding by the RWA reconciliation job.
#   - compliance cannot freeze the token on-chain. The platform-side freeze
#     still stops mediated purchases immediately, but the contract accepts
#     `freeze` only from the issuer, and the divergence is reported until they
#     sign it.
#   - the contract's one-shot payout guard (`mark_distributed`) is likewise
#     left for the issuer to arm; the ledger posting still happens, and the
#     unarmed guard is reported.
RWA_CUSTODY=platform

# ── Dispute auto-resolve thresholds (config, not hardcoded) ─────────────────
AUTO_RESOLVE_MAX_AMOUNT=50000
AUTO_RESOLVE_MIN_CONFIDENCE=0.9

# Temporary local-development KYC approval route. Keep unset outside local dev.
# TEMP_KYC_APPROVAL_PASSWORD=replace-with-a-local-password
{
  "name": "@stellartrust/admin",
  "version": "0.0.0",
  "private": true,
  "description": "StellarTrust operations console — a separately deployed, privately hosted admin application. Reads Postgres directly; never exposed on the public API.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build:client && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "build:client": "esbuild src/client/wallet-kit.ts --bundle --format=iife --target=es2020 --minify --outfile=src/client/wallet-kit.bundle.js"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "pg": "8.22.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.3.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "9.13.0",
    "jsdom": "^30.0.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.5.4",
    "typescript-eslint": "8.64.0",
    "vitest": "3.2.4"
  }
}

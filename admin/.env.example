# ── StellarTrust admin console ───────────────────────────────────────────────
# Deployed SEPARATELY and PRIVATELY. Never share a hostname with the public
# API or the public site — the whole point of the split is that someone who
# finds the public site finds no admin surface at all.

NODE_ENV=production
PORT=8090

# The same Postgres the platform uses. This console reads it directly, which
# is why there is no /api/admin on the public backend for anyone to find.
# Point it at a read-mostly role where your host supports one.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Generate with:  npm run hash-password -- "your password"
# A HASH, never the password itself: this value sits in a hosting dashboard,
# in deploy logs, and in whatever CI touched it.
ADMIN_PASSWORD_HASH=

# Signs session cookies. At least 32 random characters. Rotating it signs
# everyone out, which is the right response to a suspected compromise.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The users.id recorded as the reviewer on KYC and asset decisions. The
# database refuses a decision that does not name who made it.
ADMIN_REVIEWER_USER_ID=

# Comma-separated IP allowlist. Optional, but it is the control that makes a
# leaked password survivable. Empty means any address can reach the login form.
ADMIN_IP_ALLOWLIST=

SESSION_TTL_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

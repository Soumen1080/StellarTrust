# StellarTrust mobile app — environment template.
# Copy to `.env` and fill in. Never commit `.env` (Rules.md #2).
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle and is therefore
# public: put no secrets here. The app holds no API secrets by design — every
# privileged action is authorized by the user's own SEP-10 session token.

# Base URL of the StellarTrust API (backend/).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Stellar network the wallet signs against: testnet | public
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# WalletConnect Cloud project id, for signing with an external Stellar wallet.
# Leave empty to offer only the on-device wallet.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Must match the backend's SEP10_HOME_DOMAIN. Shown on the signing screen so a
# user can confirm what they are authenticating to.
EXPO_PUBLIC_SEP10_HOME_DOMAIN=

# EAS build project id (set by `eas init`).
EAS_PROJECT_ID=
